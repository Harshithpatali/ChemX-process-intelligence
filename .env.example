# ChemX environment configuration
# Copy to .env and fill in values. Never commit .env.

# --- Required for stakeholder explanations ---
GROQ_API_KEY=gsk_your_key_here

# Optional: override default Groq model
# Options examples: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# --- API ---
CHEMX_ENV=development
CHEMX_LOG_LEVEL=INFO
CHEMX_API_HOST=0.0.0.0
CHEMX_API_PORT=8000
# Comma-separated origins for CORS (use * only in local dev)
CHEMX_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Paths ---
CHEMX_DATA_DIR=data
CHEMX_MODEL_DIR=models
CHEMX_REPORTS_DIR=reports

# --- Soft-sensor defaults ---
CHEMX_PLS_COMPONENTS=10
CHEMX_PCA_COMPONENTS=5
CHEMX_TEST_SIZE=0.25
CHEMX_RANDOM_SEED=42
# Runtime training is for local development only. Keep false in deployed environments.
CHEMX_ALLOW_RUNTIME_TRAINING=false
